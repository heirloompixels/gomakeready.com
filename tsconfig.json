{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  // src and test only — the same set the200 checks. vitest.config.ts is left
  // out on purpose: it runs in Node, not in workerd, and reads the migrations
  // off the disk with `node:path`, which is the one thing in this repo that
  // is not a Worker. Adding @types/node to type one config file would put
  // Node's globals in reach of every file that must never have them.
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
