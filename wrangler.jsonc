{
  // gmr — go, make, ready. One Worker serves the piece, the practice, and
  // the record. Local dev needs no Cloudflare account: wrangler dev is enough
  // until D1 and the session DO land (docs/TODO.md § 4–5).
  "name": "gmr",
  // Pinned so a stray CLOUDFLARE_ACCOUNT_ID or a second logged-in account
  // can't deploy this somewhere else. The TorC account — the consolidated
  // home (2026-08-02); the default OAuth login points at old snow and gets
  // it wrong silently (CLAUDE.md § Cloudflare account).
  "account_id": "0170b714b0ee025091fed8a088f7a65a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Workers Logs from day one — the piece is a conversation with a wallet
  // attached; the logs must already be flowing when the first one starts.
  "observability": { "enabled": true },
  // No `routes` yet: gomakeready.com's nameservers are not on this account,
  // so the Worker serves at gmr.analogkyle.workers.dev until they move.
  // Static assets — fonts and the client bundle (step 3). The Worker owns
  // every HTML answer, so neither handling mode may invent a page: a miss
  // here falls through to the Hono notFound, which answers in the piece's
  // own voice.
  "assets": {
    "binding": "ASSETS",
    "directory": "./assets",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The archive. One database, this project's own — never shared with the
  // other portals (CLAUDE.md § Data). Migrations are checked into the repo
  // and applied by hand, like the deploys: `wrangler d1 migrations apply gmr`
  // (add --local for the dev copy). The binding is DB, as in the200 —
  // one database per Worker means the name never has to say which.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gmr",
      // created 2026-08-02 on TorC via `wrangler d1 create gmr`
      // (the old account's copy was ebb7f0a8-…; migrated by SQL dump)
      "database_id": "75d9dd6b-42b3-4911-8d77-6ba66ae24809",
      "migrations_dir": "migrations"
    }
  ],
  // The daily spend tally (CLAUDE.md § Guardrails 4). Bound now and spent at
  // step 4: a counter with a day's memory is KV's whole shape, and the
  // archive should not carry the wallet's bookkeeping.
  "kv_namespaces": [
    {
      "binding": "SPEND",
      // recreated 2026-08-02 on TorC (old account's was 3a301b26…; the
      // tally was empty at the move, so nothing was copied)
      "id": "3e68fce6b1e44adda4180aa468971999"
    }
  ],
  // One live conversation each: the stage cursor, the exchange count, the
  // running spend and the transcript tail the model is given (src/session-do.ts).
  // SQLite-backed on purpose — `new_sqlite_classes` is the only storage
  // backend the free plan will run, and the one the storage API assumes going
  // forward. A session has no alarm and never polls: it wakes when a visitor
  // takes a turn and costs nothing between them (CLAUDE.md § Data).
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  // The archive's other copy. D1 time travel covers the last thirty days and
  // is Cloudflare's; this is ours and outlives the database — one flat dump
  // of every table per day, as JSON lines (CLAUDE.md § Data).
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      // created 2026-07-26 via `wrangler r2 bucket create gmr-archive`
      "bucket_name": "gmr-archive"
    }
  ],
  // 09:00 UTC — three in the morning in Bozeman, two in the winter. The cron
  // is the event: there is no alarm and nothing polls (src/archive.ts).
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "vars": {
    // COMMIT is overridden with the real sha at deploy:
    //   wrangler deploy --var COMMIT:$(git rev-parse --short HEAD)
    // and reported at /_health, so a live Worker always names the commit it
    // was cut from (CLAUDE.md § Toolchain).
    "COMMIT": "dev",
    // What the day's model spend may reach before the engine goes quiet, in
    // dollars (CLAUDE.md § Guardrails 4). Raising it is a deploy flag:
    //   wrangler deploy --var DAILY_CAP_USD:25
    "DAILY_CAP_USD": "10"
  }
  // Secrets are not in this file and never will be. Before the first deploy
  // that talks to a model, by hand, with the token sourced as
  // docs/DEPLOY.md says:
  //   pnpm wrangler secret put SESSION_SECRET      # signs the presence token
  //   pnpm wrangler secret put ANTHROPIC_API_KEY   # the interview
  // With ANTHROPIC_API_KEY absent the Worker still serves the whole piece —
  // the page runs its scripted conversation and no model is called. Locally
  // both come from .dev.vars (see .dev.vars.example), which is gitignored.
}
