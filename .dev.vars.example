# gmr — local secrets. Copy to .dev.vars (gitignored) before `make dev`.
#
# In production these are `wrangler secret put SESSION_SECRET` and
# `wrangler secret put ANTHROPIC_API_KEY`, set by hand like the deploys.

# Signs the presence token minted when the sentence on-ramp completes.
# Any string will do locally; production's is long and random and lives only
# in Cloudflare's secret store.
SESSION_SECRET=dev-not-a-secret

# Left empty on purpose. Empty means no engine: the page runs its scripted
# conversation, exactly as it did before step 4, and nothing costs anything.
# Put a real key here only when you mean to spend money.
ANTHROPIC_API_KEY=
